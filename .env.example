# Copy to .env and replace every placeholder with a unique secret.
# Never commit .env or share its contents.
AEGIS_ANALYST_TOKEN=
AEGIS_APPROVER_TOKEN=
AEGIS_ANALYST_ID=analyst-local
AEGIS_APPROVER_ID=approver-local
AEGIS_AUDIT_CHECKPOINT_KEY=
AEGIS_AUDIT_CHECKPOINT_KEY_ID=local-v1
AEGIS_AUDIT_CHECKPOINT_DIR=/data/audit_checkpoints
AEGIS_DATABASE_PATH=/data/aegis.db
# Optional:
# ABUSEIPDB_API_KEY=
# Phase 2C browser authentication — use independent random secrets (32+ bytes).
# Example generation: openssl rand -hex 32
# Do not reuse the audit checkpoint key, legacy API tokens, or each other.
AEGIS_AUTH_THROTTLE_HMAC_KEY=
AEGIS_CSRF_SIGNING_KEY=
# Trusted ingress CIDRs only; empty means forwarded headers are ignored.
# The ingress must strip client-supplied X-Forwarded-For and set its own chain.
AEGIS_TRUSTED_PROXY_CIDRS=
# Exact browser origin only: scheme + hostname + optional port; no path or wildcard.
# Configure only after HTTPS is terminated by a trusted reverse proxy.
AEGIS_IAM_ALLOWED_ORIGINS=
AEGIS_SESSION_COOKIE_SECURE=true

# Phase 2D MFA — independent 32-byte key, URL-safe Base64 without padding.
# Generate separately from every other secret (for example: openssl rand -base64 32).
# Convert +/ to -_ and remove trailing =; never commit the value.
AEGIS_MFA_ENCRYPTION_KEY=
AEGIS_MFA_ENCRYPTION_KEY_ID=v1
