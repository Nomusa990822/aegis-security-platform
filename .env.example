# Copy to .env and replace every placeholder with a unique secret.
# Never commit .env or share its contents.
AEGIS_ANALYST_TOKEN=
AEGIS_APPROVER_TOKEN=
AEGIS_ANALYST_ID=analyst-local
AEGIS_APPROVER_ID=approver-local
AEGIS_AUDIT_CHECKPOINT_KEY=
AEGIS_AUDIT_CHECKPOINT_KEY_ID=local-v1
AEGIS_AUDIT_CHECKPOINT_DIR=/data/audit_checkpoints
AEGIS_DATABASE_PATH=/data/aegis.db
# Optional:
# ABUSEIPDB_API_KEY=
